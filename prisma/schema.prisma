// =============================================================================
// QASyn — multi-tenant SaaS schema (SQLite via Prisma)
// -----------------------------------------------------------------------------
// Enums are stored as String (SQLite). Allowed values are typed in lib/types.ts
// and validated with zod (lib/validation.ts) at every API boundary.
// Every functional table is scoped by organisationId (strict tenant isolation).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person. passwordHash is null for invited teammates who have not signed up yet.
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  name            String
  /// Engineer | QA | Eng manager | Founder | Admin
  role            String        @default("Admin")
  avatarInitials  String
  /// active | invited
  status          String        @default("active")
  emailVerifiedAt DateTime?
  verifyCodeHash  String?
  verifyExpiresAt DateTime?
  verifyAttempts  Int           @default(0)
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  sessions Session[]

  @@index([organisationId])
}

/// Server-side session. The cookie holds a random token, only its SHA-256 is stored.
model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Organisation currently displayed (own organisation or the read-only demo)
  activeOrganisationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([userId])
}

model Organisation {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  ownerName          String
  website            String?
  /// data:image/(png|jpeg|webp);base64,… (≤ 300 KB)
  logoUrl            String?
  addToKnowledgeBase Boolean  @default(true)
  trialStartsAt      DateTime @default(now())
  trialEndsAt        DateTime
  trialCredits       Int      @default(3000)
  creditsUsed        Int      @default(0)
  /// trial | free | starter | pro | enterprise
  plan               String   @default("trial")
  /// Simulated payment method label, e.g. "Visa •••• 4242" (never a card number)
  paymentMethod      String?
  isMockDemo         Boolean  @default(false)
  /// JSON: analysis / bug reproduction settings, dismissed cards…
  settingsJson       String   @default("{}")
  createdAt          DateTime @default(now())

  users         User[]
  onboarding    Onboarding?
  integrations  Integration[]
  tunnelMachines TunnelMachine[]
  creditEntries CreditEntry[]
  testRuns      TestRun[]
  testCases     TestCase[]
  testSuites    TestSuite[]
  testPlans     TestPlan[]
  mobileApps    MobileApp[]
  mobileTests   MobileTest[]
  apiTests      ApiTest[]
  shipWorkflows ShipWorkflow[]
  prAnalyses    PrAnalysis[]
  agentTests    AgentTest[]
  contextSources ContextSource[]
  graphNodes    ContextGraphNode[]
  graphEdges    ContextGraphEdge[]
  apiChains     ApiTestChain[]
  agentSuites   AgentTestSuite[]
  projects      Project[]
  schedules     Schedule[]
  planExecutions TestPlanExecution[]
  dataProfiles  DataProfile[]
  visualBaselines VisualBaseline[]
  webhooks      Webhook[]
  notificationRules NotificationRule[]
  components    TestComponent[]
  exploratorySessions ExploratorySession[]
  personas      Persona[]
  redTeamSuites RedTeamSuite[]
  emailInboxes  EmailTestInbox[]
  securityScans SecurityScan[]
  riskAnalyses  RiskAnalysis[]
  gridNodes     InfrastructureGridNode[]
  bugReports    BugReport[]
  pullRequests  PullRequestCheck[]
  crawlSessions CrawlSession[]
  requirements  Requirement[]
  knowledge     KnowledgeItem[]
  environments  EnvironmentConfig[]
  globalVariables GlobalVariable[]
  authProfiles  AuthProfile[]
  proxyProfiles ProxyProfile[]
  remoteBrowserProfiles RemoteBrowserProfile[]
  viewports     ViewportSetting[]
  apiTokens     ApiToken[]
  auditLogs     SystemAuditLog[]
  uploads       Upload[]
  testCaseVersions TestCaseVersion[]
  testCaseRuns  TestCaseRun[]
  testFolders   TestFolder[]
}

model Onboarding {
  id               String       @id @default(cuid())
  organisationId   String       @unique
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  currentStep      Int          @default(1)
  appDescription   String?
  /// staging | localhost
  reachMode        String?
  environmentUrl   String?
  localPort        Int?
  tunnelToken      String?
  tunnelEnrolled   Boolean      @default(false)
  /// none | signup_test_account | credentials
  appLoginType     String?
  appLoginUsername String?
  /// AES-256-GCM encrypted (lib/crypto.ts), never sent back to the browser
  appLoginPassword String?
  /// JSON array of pain points
  painPoints       String       @default("[]")
  userRole         String?
  testingMaturity  String?
  focusPriority    String?
  /// e-mails joined by "\n"
  invitedEmails    String       @default("")
  completedAt      DateTime?
  updatedAt        DateTime     @updatedAt
}

model Integration {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// GITHUB | GITLAB | JIRA | LINEAR | SLACK
  provider       String
  /// CONNECTED | INDEXING | FAILED
  status         String
  detail         String?
  connectedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, provider])
}

/// A machine enrolled through the ContextQA tunnel agent (Tunnels module).
model TunnelMachine {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// win | mac | linux
  os             String   @default("win")
  /// pending | connected | expired | offline
  status         String   @default("expired")
  browserHost    Boolean  @default(false)
  token          String
  routeCount     Int      @default(0)
  lastSeenAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organisationId])
}

/// A credit ledger row: one charge, refund or grant for the workspace.
model CreditEntry {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  occurredAt     DateTime     @default(now())
  /// e.g. Web test run, Autonomous crawl, Root cause analysis
  action         String
  /// Signed credits: negative for charges, positive for refunds and grants.
  credits        Int
  /// charge | refund | grant
  kind           String       @default("charge")
  note           String?

  @@index([organisationId, occurredAt])
}

model TestRun {
  id                  String       @id @default(cuid())
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  release             Int
  version             String
  title               String
  branch              String?
  prNumber            Int?
  /// SUCCESS | FAILED
  status              String
  qualityScore        Int
  coverage            Float
  costAvoided         Float
  codeChanges         Int
  impactedTests       Int
  regressionsCaught   Int
  anomaliesReproduced Int
  testsAdded          Int
  testsTotal          Int
  testsPassed         Int
  durationMs          Int
  /// JSON execution logs (step-by-step evidence trail)
  logsJson            String       @default("[]")
  /// JSON evidence: Base64 screenshots, trace dumps, console logs
  evidenceJson        String       @default("[]")
  planId              String?
  projectId           String?
  project             Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  passRate            Float        @default(0)
  createdAt           DateTime     @default(now())
  logs                LogLine[]

  @@index([organisationId, createdAt])
}

model LogLine {
  id        String   @id @default(cuid())
  testRunId String
  testRun   TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  timestamp DateTime
  stream    String
  tag       String
  message   String

  @@index([testRunId, timestamp])
}

model TestCase {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title          String
  module         String
  description    String?
  /// JSON array of labels shown in Test Studio
  labelsJson     String        @default("[]")
  /// critical | high | medium | low
  criticality    String
  /// passing | failing | draft | flaky
  status         String        @default("draft")
  environment    String?
  version        String        @default("1.0")
  platform       String        @default("web")
  stepsCount     Int           @default(1)
  /// JSON array of NLP steps for the Test Case Studio: [{ id, action, target, value, selector }]
  stepsJson      String        @default("[]")
  /// JSON array of step-level assertions
  assertionsJson String        @default("[]")
  /// JSON object of step variables
  variablesJson  String        @default("{}")
  /// Linked production suite (optional)
  suiteId        String?
  suite          TestSuite?    @relation("SuiteCases", fields: [suiteId], references: [id], onDelete: SetNull)
  /// Modular folder shown in the Test Cases grid
  folderId       String?
  folder         TestFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Data-driven testing profile (optional)
  dataProfileId  String?
  dataProfile    DataProfile?  @relation(fields: [dataProfileId], references: [id], onDelete: SetNull)
  /// Multi-project workspace (optional)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// manual | ai | crawl
  source         String        @default("manual")
  lastRunAt      DateTime?
  createdAt      DateTime      @default(now())
  requirements   Requirement[]
  testSuites     TestSuite[]
  testPlans      TestPlan[]
  versions       TestCaseVersion[]
  runs           TestCaseRun[]

  @@index([organisationId, module])
}

model TestCaseVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  testCaseId     String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  version        Int
  summary        String
  author         String       @default("System")
  /// JSON array of step labels added in this version
  addedJson      String       @default("[]")
  /// JSON array of step labels removed in this version
  removedJson    String       @default("[]")
  /// Full step snapshot used by Restore
  stepsJson      String       @default("[]")
  createdAt      DateTime     @default(now())

  @@unique([testCaseId, version])
  @@index([organisationId])
}

model TestCaseRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  testCaseId     String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  runNumber      Int
  /// PASSED | FAILED
  status         String
  /// Automated | Manual
  trigger        String       @default("Automated")
  /// Standalone Run | test plan name
  mode           String       @default("Standalone Run")
  durationMs     Int          @default(0)
  failedStep     Int?
  failedStepText String?
  autoFix        Boolean      @default(false)
  createdBy      String       @default("System")
  /// JSON execution log
  logJson        String       @default("[]")
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
  @@index([testCaseId])
}

model TestSuite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// manual | on_pr | nightly | weekly
  schedule       String       @default("manual")
  /// Module filter ("" = all modules)
  module         String       @default("")
  /// Web | Mobile | API
  platform       String       @default("Web")
  /// JSON array of labels
  labelsJson     String       @default("[]")
  /// JSON array of prerequisite test case ids
  prerequisitesJson String    @default("[]")
  testCasesCount Int          @default(0)
  passRate       Float        @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  testCases      TestCase[]
  primaryCases   TestCase[]   @relation("SuiteCases")
  plans          TestPlan[]
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

model TestPlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  schedule       String       @default("manual")
  module         String       @default("")
  /// Production | Staging | QA | Localhost
  environment    String?
  /// JSON array of browsers: Chromium | Firefox | WebKit
  browsersJson   String       @default("[\"Chromium\"]")
  testCasesCount Int          @default(0)
  passRate       Float        @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  testCases      TestCase[]
  suites         TestSuite[]
  /// JSON: execution settings, notifications, recovery actions, proxy/remote routing
  settingsJson   String       @default("{}")
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

/// Uploaded mobile build (APK / IPA). fileUrl is a simulated storage reference.
model MobileApp {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// iOS | Android
  platform       String
  version        String
  fileUrl        String
  sizeBytes      Int          @default(0)
  createdAt      DateTime     @default(now())
  tests          MobileTest[]

  @@index([organisationId])
}

model MobileTest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  appId          String?
  app            MobileApp?   @relation(fields: [appId], references: [id], onDelete: SetNull)
  name           String
  /// e.g. "iOS 17 · iPhone 15", "Android 14 · Pixel 8"
  device         String
  /// Cloud device selector (iOS 14+, Android API 21+)
  deviceSelector String       @default("")
  /// JSON array of gestures: [{ id, gesture: Tap|Swipe|Scroll|Enter Text, target, value }]
  gesturesJson   String       @default("[]")
  /// idle | running | passed | failed
  status         String       @default("idle")
  /// JSON array of execution log lines
  logsJson       String       @default("[]")
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// API test: ordered request chain with assertions and variable extraction (API chaining).
model ApiTest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// JSON array of request steps: [{ id, method, url, headers, body, assertions, extractionRules }]
  requestsJson   String       @default("[]")
  /// idle | running | passed | failed
  status         String       @default("idle")
  /// JSON array of execution results (status, payloads, assertion outcomes)
  resultsJson    String       @default("[]")
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Autonomous Ship workflow run (crawl → generate → execute → report).
model ShipWorkflow {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// idle | running | passed | failed
  status         String       @default("idle")
  /// Go | No-Go | Pending
  decision       String       @default("Pending")
  /// JSON array of autonomous pipeline stages with evidence
  stagesJson     String       @default("[]")
  decisionReason String?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// PR impact analysis: files changed → regression scope → Go/No-Go.
model PrAnalysis {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prNumber           Int
  branch             String
  title              String
  /// JSON array of changed file paths
  filesChangedJson   String       @default("[]")
  /// JSON array of selected test case ids (regression scope)
  scopeJson          String       @default("[]")
  /// low | medium | high
  riskLevel          String
  /// Go | No-Go | Pending
  decision           String       @default("Pending")
  /// JSON impact assessment text
  impactAssessment   String       @default("{}")
  createdAt          DateTime     @default(now())

  @@index([organisationId])
}

/// AI agent evaluation: guardrails, hallucination checks, tool-call validation.
model AgentTest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// guardrail | hallucination | toolcall
  kind           String
  /// JSON: model response / tool calls to evaluate
  inputJson      String       @default("{}")
  /// JSON: evaluation results (findings, scores)
  resultsJson    String       @default("[]")
  /// idle | passed | failed
  status         String       @default("idle")
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

model BugReport {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title             String
  /// critical | high | medium | low
  severity          String
  /// reproduced | open | fixed
  status            String
  /// Steps joined by "\n"
  reproductionSteps String
  videoUrl          String?
  rootCause         String?
  environment       String?
  /// jira | linear | test_run | manual
  source            String       @default("manual")
  externalKey       String?
  createdAt         DateTime     @default(now())

  @@index([organisationId, createdAt])
}

model PullRequestCheck {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prNumber       Int
  title          String
  branch         String
  author         String
  /// passed_baseline | regression_caught | running
  status         String
  /// low | medium | high
  riskLevel      String
  filesChanged   Int
  testsRun       Int          @default(0)
  regressions    Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organisationId, prNumber])
}

model CrawlSession {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetUrl      String
  /// running | completed | failed
  status         String
  pagesVisited   Int          @default(0)
  flowsMapped    Int          @default(0)
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  /// JSON array of { offsetMs, tag, message }
  logs           String       @default("[]")
  /// Require approval | Auto publish
  publishMode    String       @default("Require approval")
  /// JSON array of selected test case types
  testTypesJson  String       @default("[]")
  /// JSON array of prerequisite test case ids
  prerequisitesJson String    @default("[]")
  /// Requirement auto-created for this crawl
  requirementId  String?
  /// Explore prompt entered in the New Crawl modal
  explorePrompt  String       @default("")
  /// Additional context entered in the New Crawl modal
  additionalContext String    @default("")
  /// Create a Test Suite / Test Plan from generated cases
  createSuite    Boolean      @default(false)
  createPlan     Boolean      @default(false)

  @@index([organisationId, startedAt])
}

model Requirement {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code             String
  title            String
  /// manual | jira | linear | doc | import
  source           String       @default("manual")
  /// covered | partial | uncovered
  coverageStatus   String       @default("uncovered")
  linkedTestsCount Int          @default(0)
  createdAt        DateTime     @default(now())
  testCases        TestCase[]

  @@unique([organisationId, code])
}

model KnowledgeItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title          String
  /// website | doc | openapi | upload
  type           String
  urlOrPath      String
  /// indexed | indexing
  status         String
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

model EnvironmentConfig {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  baseUrl        String
  description    String       @default("")
  accent         String       @default("#5b4ee8")
  /// none | basic | bearer | form
  authType       String       @default("none")
  /// JSON object of KEY → value
  variablesJson  String       @default("{}")
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  variables      EnvironmentVariable[]

  @@index([organisationId])
}

/// Workspace-wide variable, accessible from every environment and test case.
model GlobalVariable {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// String | Number | Boolean | Secret
  type           String       @default("String")
  /// RO | RW
  permission     String       @default("RO")
  value          String       @default("")
  /// JSON array of tag strings
  tags           String       @default("[]")
  description    String       @default("")
  createdAt      DateTime     @default(now())

  @@unique([organisationId, name])
  @@index([organisationId])
}

/// Saved app login used by crawls, test cases and Ship sessions.
model AuthProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  appUrl         String
  loginUrl       String       @default("")
  /// Username and password | SSO | API token | Cookie
  method         String       @default("Username and password")
  username       String       @default("")
  passwordCipher String       @default("")
  autoSignIn     Boolean      @default(true)
  /// JSON: verification selector, OTP handling, extra headers, session metadata
  advancedJson   String       @default("{}")
  lastSignedInAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Network proxy used by the remote browser fleet.
model ProxyProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// Full proxy URL, e.g. http://host:port
  url            String       @default("")
  host           String
  port           Int          @default(8080)
  username       String       @default("")
  passwordCipher String       @default("")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Named viewport used by test plans and execution settings.
model ViewportSetting {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  width          Int
  height         Int
  /// Mobile | Tablet | Desktop
  category       String       @default("Desktop")
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

model ApiToken {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  tokenPrefix    String
  tokenHash      String       @unique
  /// JSON array of scope ids (e.g. TEST_CASE_READ)
  scopesJson     String       @default("[]")
  expiresAt      DateTime?
  /// JSON array of CIDR / IP strings; empty = unrestricted
  ipAllowlistJson String      @default("[]")
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// External browser endpoint (Selenium/Playwright grid, BrowserStack, Sauce Labs…).
model RemoteBrowserProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  remoteUrl      String
  username       String       @default("")
  password       String       @default("")
  /// verified | unverified
  status         String       @default("unverified")
  lastCheckedAt  DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

model SystemAuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorEmail     String
  action         String
  target         String
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
}

/// Uploaded artefact metadata (file contents are not stored by this prototype).
model Upload {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fileName       String
  /// apk | ipa | har | postman | video | other
  kind           String
  sizeBytes      Int
  uploadedBy     String
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Context ingestion: Jira stories, Swagger docs, Figma layouts, raw URLs, video logs.
model ContextSource {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// JIRA_STORY | SWAGGER_DOC | FIGMA_LAYOUT | RAW_URL | VIDEO_LOG
  type           String
  sourceUrl      String
  /// JSON metadata: commit hashes, Jira tickets, raw text, scraped data
  metadataJson   String       @default("{}")
  /// Extracted plain text used for retrieval
  extractedText  String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Knowledge-graph node derived from a ContextSource.
model ContextGraphNode {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityName     String
  /// requirement | flow | screen | api | bug | pr
  entityType     String
  propertiesJson String       @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Knowledge-graph edge between two nodes.
model ContextGraphEdge {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sourceId       String
  targetId       String
  /// covers | implements | blocks | related_to
  relationType   String
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// API test chain (alias of ApiTest with isolated execution results).
model ApiTestChain {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  requestsJson   String       @default("[]")
  resultsJson    String       @default("[]")
  status         String       @default("idle")
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// AI agent evaluation suite: endpoint, guardrail watchlists, knowledge base.
model AgentTestSuite {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name               String
  /// e.g. Agentforce | LangChain | Bedrock endpoint URL
  agentEndpoint      String
  /// JSON array of guardrail pattern descriptors
  guardrailsJson     String       @default("[]")
  /// JSON array of knowledge base references (ContextSource ids)
  knowledgeBaseJson  String       @default("[]")
  lastVerdict        String?
  createdAt          DateTime     @default(now())

  @@index([organisationId])
}

/// Multi-project workspace within an organisation.
model Project {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  /// web | mobile | api
  type           String       @default("web")
  baseUrl        String?
  configJson     String       @default("{}")
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  testCases      TestCase[]
  testSuites     TestSuite[]
  testPlans      TestPlan[]
  crawlSessions  CrawlSession[]
  testRuns       TestRun[]

  @@index([organisationId])
}

/// Cron schedule for a test plan.
model Schedule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  testPlanId     String
  name           String
  cronExpression String
  timezone       String       @default("UTC")
  enabled        Boolean      @default(true)
  lastFiredAt    DateTime?
  nextFireAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Execution record of a scheduled / manual / CI triggered plan.
model TestPlanExecution {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  testPlanId     String
  /// PENDING | RUNNING | PASSED | FAILED
  status         String
  /// manual | schedule | ci
  triggeredBy    String       @default("manual")
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  resultsJson    String       @default("{}")

  @@index([organisationId])
}

/// Per-environment variable (secrets are masked in UI/logs).
model EnvironmentVariable {
  id            String            @id @default(cuid())
  environmentId String
  environment   EnvironmentConfig @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  key           String
  value         String
  isSecret      Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@unique([environmentId, key])
}

/// Data-driven testing: rows of key-value pairs (manual, csv or excel).
model DataProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  /// RO | RW
  permission     String       @default("RO")
  /// JSON array of environment ids this profile is scoped to
  environmentIds String       @default("[]")
  /// manual | csv | excel
  sourceType     String       @default("manual")
  columnsJson    String       @default("[]")
  rowsJson       String       @default("[]")
  createdAt      DateTime     @default(now())
  testCases      TestCase[]

  @@index([organisationId])
}

/// Approved visual baseline screenshot.
model VisualBaseline {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  testCaseId     String
  stepIndex      Int
  screenshotB64  String       @default("")
  pixelHash      String       @default("")
  /// approved | pending | rejected
  status         String       @default("approved")
  createdAt      DateTime     @default(now())
  diffs          VisualDiff[]

  @@index([organisationId])
}

/// Visual regression diff against a baseline.
model VisualDiff {
  id               String         @id @default(cuid())
  baselineId       String
  baseline         VisualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  testRunId        String
  diffImageB64     String         @default("")
  mismatchPercent  Float          @default(0)
  /// pending | approved | rejected
  status           String         @default("pending")
  createdAt        DateTime       @default(now())
}

/// Outbound webhook (test results delivery).
model Webhook {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name            String
  url             String
  secret          String?
  events          String       @default("[]")
  active          Boolean      @default(true)
  lastDeliveredAt DateTime?
  createdAt       DateTime     @default(now())

  @@index([organisationId])
}

/// Notification rule (slack / teams / email).
model NotificationRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  channel        String
  events         String       @default("[]")
  configJson     String       @default("{}")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Reusable step group (Test Studio components).
/// Reusable step group inserted into test cases from Test Studio.
model TestComponent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  stepsJson      String       @default("[]")
  description    String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Modular folder grouping test cases in the grid and Studio.
model TestFolder {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#5b4ee8")
  createdAt      DateTime     @default(now())
  testCases      TestCase[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

/// Exploratory testing session (capture → convert to test case).
model ExploratorySession {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId            String
  startedAt         DateTime     @default(now())
  endedAt           DateTime?
  actionsJson       String       @default("[]")
  notesJson         String       @default("[]")
  convertedCaseId   String?
  /// active | completed | converted
  status            String       @default("active")

  @@index([organisationId])
}

/// User persona for agent stress-testing.
model Persona {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  /// frustrated | confused | impatient | multilingual | adversarial
  temperament    String
  language       String       @default("en")
  behaviorRules  String       @default("[]")
  promptTemplate String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Red team adversarial suite (OWASP LLM Top 10).
model RedTeamSuite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  attacksJson    String       @default("[]")
  resultsJson    String       @default("[]")
  score          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Web Vitals / performance measurement.
model PerformanceMetric {
  id         String   @id @default(cuid())
  testRunId  String
  /// LCP | FCP | CLS | TTFB | TTI
  metric     String
  value      Float
  threshold  Float?
  passed     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([testRunId])
}

// --- MARKETING & CMS CONTENT (global, not tenant-scoped) ---

model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String
  contentHtml    String
  coverImage     String?
  authorName     String
  authorRole     String
  authorAvatar   String?
  tags           String
  readTimeMin    Int      @default(5)
  publishedAt    DateTime @default(now())
  featured       Boolean  @default(false)
}

model CaseStudy {
  id             String   @id @default(cuid())
  slug           String   @unique
  companyName    String
  industry       String
  logoUrl        String?
  heroQuote      String
  challenge      String
  solution       String
  resultsJson    String
  fullStory      String
  featured       Boolean  @default(false)
  publishedAt    DateTime @default(now())
}

model GlossaryTerm {
  id             String   @id @default(cuid())
  slug           String   @unique
  term           String
  category       String
  shortDef       String
  detailedDef    String
  relatedTerms   String
}

model Course {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  level          String
  durationHours  Int
  description    String
  syllabusJson   String
  badgeName      String
}

model Certification {
  id             String   @id @default(cuid())
  courseId       String
  candidateName  String
  candidateEmail String
  certCode       String   @unique
  score          Int
  issuedAt       DateTime @default(now())
}

model LeadCapture {
  id             String   @id @default(cuid())
  email          String
  source         String
  metadataJson   String?
  createdAt      DateTime @default(now())
}

// --- DASHBOARD EXPANSIONS (tenant-scoped) ---

model EmailTestInbox {
  id             String   @id @default(cuid())
  organisationId String
  emailAddress   String   @unique
  label          String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  messages       EmailTestMessage[]
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model EmailTestMessage {
  id             String   @id @default(cuid())
  inboxId        String
  from           String
  to             String
  subject        String
  bodyText       String
  bodyHtml       String
  extractedOtp   String?
  extractedLinks String
  receivedAt     DateTime @default(now())
  inbox          EmailTestInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
}

model SecurityScan {
  id             String   @id @default(cuid())
  organisationId String
  targetUrl      String
  scanType       String
  status         String
  highCount      Int      @default(0)
  mediumCount    Int      @default(0)
  lowCount       Int      @default(0)
  findingsJson   String
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model RiskAnalysis {
  id             String   @id @default(cuid())
  organisationId String
  branchName     String
  prNumber       Int?
  riskScore      Int
  riskLevel      String
  factorsJson    String
  suggestedTests String
  analyzedAt     DateTime @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model InfrastructureGridNode {
  id             String   @id @default(cuid())
  organisationId String
  browserName    String
  platform       String
  version        String
  status         String
  currentRunId   String?
  concurrencyCap Int      @default(5)
  activeWorkers  Int      @default(0)
  lastHeartbeat  DateTime @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}
