# Base SQLite locale (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret de chiffrement AES-256-GCM (tokens, credentials). Obligatoire en production.
QASYN_SECRET="change-me-with-openssl-rand-base64-48"

# Articul8 Bivia multimodal decision engine (server-side only).
# The placeholder deliberately avoids the provider token prefix so the
# repository-wide secret scan (git grep) stays clean.
BIVIA_API_KEY="replace_with_your_bivia_api_key"
BIVIA_API_URL="https://api.articul8.ai/bivia"
